local mainAlert, parentAlert = ...

local LinearLayout = luajava.bindClass("android.widget.LinearLayout")
local TextView = luajava.bindClass("android.widget.TextView")
local Button = luajava.bindClass("android.widget.Button")
local Color = luajava.bindClass("android.graphics.Color")
local GradientDrawable = luajava.bindClass("android.graphics.drawable.GradientDrawable")
local ColorDrawable = luajava.bindClass("android.graphics.drawable.ColorDrawable")
local AlertDialog = luajava.bindClass("android.app.AlertDialog")
local Intent = luajava.bindClass("android.content.Intent")
local Uri = luajava.bindClass("android.net.Uri")
local Gravity = luajava.bindClass("android.view.Gravity")
local RotateAnimation = luajava.bindClass("android.view.animation.RotateAnimation")

local alert

local layout = LinearLayout(service)
layout.setOrientation(1)
layout.setPadding(60, 60, 60, 60)
layout.setBackgroundColor(Color.parseColor("#F3F4F6"))
layout.setLayoutParams(LinearLayout.LayoutParams(-1, -1))

local topLayout = LinearLayout(service)
topLayout.setOrientation(0)
local topParams = LinearLayout.LayoutParams(-1, -2)
topParams.setMargins(0, 0, 0, 30)
topLayout.setLayoutParams(topParams)

local btnBack = TextView(service)
btnBack.setText("[Kembali]")
btnBack.setTextSize(16)
btnBack.setTextColor(Color.parseColor("#3B82F6"))
btnBack.setGravity(Gravity.LEFT | Gravity.CENTER_VERTICAL)
local btnBackParams = LinearLayout.LayoutParams(-2, -2)
btnBackParams.setMargins(0, 0, 30, 0)
btnBack.setLayoutParams(btnBackParams)
topLayout.addView(btnBack)

local title = TextView(service)
title.setText("Tentang Pengembang")
title.setTextSize(32)
title.setTextColor(Color.parseColor("#1F2937"))
title.setGravity(Gravity.LEFT | Gravity.CENTER_VERTICAL)
local titleParams = LinearLayout.LayoutParams(0, -2, 1)
title.setLayoutParams(titleParams)
topLayout.addView(title)

layout.addView(topLayout)

local greetLayout = LinearLayout(service)
greetLayout.setOrientation(0)
greetLayout.setGravity(Gravity.CENTER)
local greetParams = LinearLayout.LayoutParams(-1, -2)
greetParams.setMargins(0, 60, 0, 40)
greetLayout.setLayoutParams(greetParams)

local greetText = TextView(service)
greetText.setText("Hai! ")
greetText.setTextSize(32)
greetText.setTextColor(Color.parseColor("#1F2937"))
greetLayout.addView(greetText)

local handEmoji = TextView(service)
handEmoji.setText("👋")
handEmoji.setTextSize(36)
greetLayout.addView(handEmoji)

layout.addView(greetLayout)

local waveAnim = RotateAnimation(-15.0, 15.0, 1, 0.8, 1, 0.9)
waveAnim.setDuration(400)
waveAnim.setRepeatMode(2)
waveAnim.setRepeatCount(-1)
handEmoji.startAnimation(waveAnim)

local desc = TextView(service)
desc.setText("Saya Ananda Saputrasari mengucapkan banyak terima kasih atas dukungan Anda.\n\nAplikasi Kalkulator ini terus dikembangkan agar selalu ramah dan mudah digunakan, khususnya bagi teman-teman pengguna pembaca layar.")
desc.setTextSize(18)
desc.setTextColor(Color.parseColor("#4B5563"))
desc.setGravity(Gravity.CENTER)
local descParams = LinearLayout.LayoutParams(-1, -2)
descParams.setMargins(0, 0, 0, 80)
desc.setLayoutParams(descParams)
layout.addView(desc)

local btnWa = Button(service)
btnWa.setText("Hubungi WhatsApp")
btnWa.setAllCaps(false)
btnWa.setTextColor(Color.parseColor("#FFFFFF"))
btnWa.setTextSize(18)
local bgWa = GradientDrawable()
bgWa.setColor(Color.parseColor("#25D366"))
bgWa.setCornerRadius(15)
btnWa.setBackgroundDrawable(bgWa)
local btnWaParams = LinearLayout.LayoutParams(-1, -2)
btnWaParams.setMargins(0, 0, 0, 30)
btnWa.setLayoutParams(btnWaParams)
layout.addView(btnWa)

local dialog = AlertDialog.Builder(service)
dialog.setView(layout)
dialog.setCancelable(true)
alert = dialog.create()

btnBack.setOnClickListener(luajava.createProxy("android.view.View$OnClickListener", {
    onClick = function(v)
        if alert then alert.dismiss() end
    end
}))

btnWa.setOnClickListener(luajava.createProxy("android.view.View$OnClickListener", {
    onClick = function(v)
        if alert then alert.dismiss() end
        if mainAlert then mainAlert.dismiss() end
        if parentAlert then parentAlert.dismiss() end
        
        local intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://wa.me/6281234567890"))
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        service.startActivity(intent)
    end
}))

alert.getWindow().setType(2032)
alert.show()

local window = alert.getWindow()
window.setLayout(-1, -1)
window.setBackgroundDrawable(ColorDrawable(Color.parseColor("#F3F4F6")))
window.getDecorView().setPadding(0, 0, 0, 0)